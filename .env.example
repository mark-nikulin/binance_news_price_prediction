# Copy to `.env` and adjust values as needed.
# Note: Public Binance announcements and OKX market/instrument endpoints require no API keys.

# Root directory for cached news, market bars, embeddings, trained models, signals, and reports.
# Defaults to `./data` if unset.
NP_DATA_DIR=./data

# Optional: HuggingFace / Torch cache or offline mode settings (uncomment if needed on server)
# HF_HOME=./.cache/huggingface
# TOKENIZERS_PARALLELISM=false
